  <joint name="FR_foot_fixed" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="0.156168 -0.000054 -0.175433"/>
    <parent link="FR_calf"/>
    <child link="FR_foot"/>
  </joint>
