<?xml version="1.0" ?>
<robot name="LgDog1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================
       ⚠️ 碰撞几何约定（照 go1.urdf）：全部用【图元】，不用网格。
       box 1（躯干 AABB）+ cylinder 16（hip×4 + thigh×8 + calf×4）+ sphere 4（足端）
       为什么不能用网格（本仓库实测到的两个后果）：
         1) PhysX 会把网格碰撞体膨胀约 8.6mm —— 曾把 12mm 的足端球整个罩住，
            导致足端接触力恒为 0、feet_air_time 等 4 个奖励静默失效；
         2) 凸包 ≠ 真实外形 —— 躯干凸包与大腿凸包在零位就相交，自碰撞力把机器人顶翻。
       图元半径取自各网格沿轴径向剖面的中位半径（代表典型表面距离），
       大腿按锥形用了两段（髋端粗 0.052、膝端细 0.019~0.028）。
       实测：膝/髋/躯干图元在正常行走范围（各关节±0.45 rad）内从不低于足端球，
       不会抢走足端的地面接触。
       ================================================================== -->

  <!-- ==================================================================
       关节 <limit> 在这里是「关节侧（输出侧）」数值，直接决定训练时的
       torque_limits（硬裁剪）与 dof_vel_limits（软限位惩罚），见
       legged_gym/envs/base/legged_robot.py:504 / 1189。

       ── 两条换算链（速度与力矩各自独立）────────────────────────────
       [1] 供电电压：电机的空载转速 ∝ 电压，原按 48V 给的 37.7 rad/s
           是 48V 下的值，实机 24V → 电机转速 37.7/2 = 18.85 rad/s。
           力矩不受影响：峰值力矩由电流上限决定（Kt·I_max），与电压无关
           （只是高转速下电压余量变小、可用力矩下降，这里按常数上限建模）。
       [2] 减速箱：calf 带 1:2 减速比，输出力矩 ×2、输出转速 ÷2。
       ⇒ 合成结果（本文件里的最终值）：
           hip / thigh（直驱）：effort 10 Nm，velocity 18.85 rad/s
           calf      （1:2）  ：effort 20 Nm，velocity  9.425 rad/s

       注意 <limit lower/upper>（角度范围）不参与任何换算，永远是关节侧数值：
       它是按腿的实际姿态目视标定的，而减速箱位于电机与关节之间，
       关节能摆多少与后面挂几比几的减速箱无关。故 calf 仍为 ±0.7
       （对应电机侧 ±1.4，该数填在驱动器/编码器的限位里，不进本文件）。
       ================================================================== -->

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.84705882 0.84705882 0.84705882 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>


  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base_link.STL" scale="1 1 1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- 碰撞代理：躯干是接近长方体的壳，取网格 AABB（六个极值面精确，
         只在两腿之间的凹腔处过填——自碰撞是关的，无影响）。
         换网格碰撞的原因见文件头注释。 -->
    <collision>
      <origin rpy="0 0 0" xyz="-0.2020 0.0000 0.0023"/>
      <geometry>
        <box size="0.4040 0.2660 0.1141"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.21 0.003 0.004"/>
      <mass value="3.487"/>
      <inertia ixx="0.019" ixy="0" ixz="0" iyy="0.075" iyz="0" izz="0.09"/>
    </inertial>
  </link>

  <link name="FL_hip">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/FL_hip.STL" scale="1 1 1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 1.570796 0" xyz="+0.047971 0 0"/>
      <geometry>
        <cylinder radius="0.0230" length="0.0886"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.05265 -0.004 -0.0003443"/>
      <mass value="0.445"/>
      <inertia ixx="0.0002132" ixy="0.0000108" ixz="0.0000001" iyy="0.0003801" iyz="0" izz="0.0002938"/>
    </inertial>
  </link>

  <link name="FL_thigh">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/FL_thigh.STL" scale="1 1 1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 -2.069089 0" xyz="-0.036567 +0.017090 -0.019895"/>
      <geometry>
        <cylinder radius="0.0518" length="0.090"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 -2.069089 0" xyz="-0.121889 +0.017090 -0.066318"/>
      <geometry>
        <cylinder radius="0.0194" length="0.120"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0272593 0.0546815 -0.012194"/>
      <mass value="0.974"/>
      <inertia ixx="0.0015537" ixy="0.0006015" ixz="-0.0010189" iyy="0.0034659" iyz="0.0002914" izz="0.0031496"/>
    </inertial>
  </link>

  <link name="FL_calf">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/FL_calf.STL" scale="1 1 1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- 小腿碰撞体：胶囊（URDF 用 cylinder 表达，Isaac 侧 replace_cylinder_with_capsule=True
         会转成胶囊；MuJoCo 侧转换脚本也输出 capsule，两边形状一致）。
         轴向 = 膝轴→足端球心；r=0.035、长 0.19，末端圆头正好接上足端球。
         尺寸取自小腿网格实测截面半径（膝端 0.026 → 踝端 0.045，取 0.035 折中，误差 ≤9mm）。
         r=0.025 < 网格沿轴最小截面半径 0.026 → 胶囊内切于真实小腿，绝不会产生
         真机上不存在的碰撞。零位站姿下胶囊最低点比足端球底高 28.9mm。
         ⚠️ 必须用图元而不是网格：PhysX 会把网格碰撞体膨胀约 8.6mm，之前正是它把
            12mm 的足端球整个罩住、导致足端接触力恒为 0。
         注：腿折到极端角度（|小腿相对竖直| > 40°）时小腿本来就会触地——真实网格
            在同一角度也低 2.6mm，这是真实行为，由 collision 奖励惩罚。 -->
    <collision>
      <origin rpy="0.00023 2.414226 0" xyz="0.063166 -0.000022 -0.070958"/>
      <geometry>
        <cylinder radius="0.025" length="0.19"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.1171227 -0.0000169 -0.1083104"/>
      <mass value="0.213"/>
      <inertia ixx="0.0007557" ixy="0.0000001" ixz="0.0006437" iyy="0.0013644" iyz="0" izz="0.0006473"/>
    </inertial>
  </link>

