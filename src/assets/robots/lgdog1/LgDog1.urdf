  <!-- ==================================================================
       足端：独立 link + 固定关节（照 go1.urdf 的 FL_foot 约定）
       为什么必须有：legged_gym 用 body 名做子串匹配找脚
         feet_names = [s for s in body_names if cfg.asset.foot_name in s]
       URDF 里没有名字含 "foot" 的 link 时，feet_indices 为空，
       feet_air_time / feet_stumble / foot_clearance / feet_contact_forces
       四个奖励会静默变成 0（不报错，但完全失效）。
       dont_collapse="true" 必须保留：legged_gym 的 collapse_fixed_joints=True
       否则会把这个 link 合并回 calf，名字就没了。
       球心 = 小腿网格最低点上方 r，使球底与网格最低点重合 → 站立高度不变。
       r=0.012 取自实测足端接触斑半径（最低 2mm 内贴地点半径 0.0106）。
       ================================================================== -->
  <joint name="FL_foot_fixed" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="0.156168 -0.000054 -0.175433"/>
    <parent link="FL_calf"/>
    <child link="FL_foot"/>
  </joint>
  <link name="FL_foot">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="5.76e-07" ixy="0.0" ixz="0.0" iyy="5.76e-07" iyz="0.0" izz="5.76e-07"/>
    </inertial>
  </link>

